# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/cpfriendfinder
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Server Configuration
SERVER_PORT=8080
# S3-compatible storage (รูปโปรไฟล์/ไฟล์แชท) เช่น MinIO หรือ Cloudflare R2
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_PUBLIC_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Cloudflare Realtime TURN (จำเป็นสำหรับ voice call ข้ามเครือข่าย) — ใช้กับ server.js gateway
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_TTL=86400
